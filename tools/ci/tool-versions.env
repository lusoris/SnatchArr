#
# Images of the workflow gate, each pinned by version and digest:
# ACTIONLINT_IMAGE is run by tools/ci/workflow-check.sh; RENOVATE_IMAGE supplies built-in presets
# and Docker-capable managers offline to tools/ci/renovate_presets.py (.github/workflows/ci.yml);
# SEMGREP_IMAGE is run by tools/ci/semgrep_scan.py.
# Renovate reads all three from the line (renovate.json, customManagers) and moves them together.
# mirror.gcr.io serves Docker Hub's digests; hosted runners share Docker Hub's anonymous pull limit.
# zizmor is installed from PyPI with hashes (tools/ci/zizmor-requirements.txt).
ACTIONLINT_IMAGE=mirror.gcr.io/rhysd/actionlint:1.7.12@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667
RENOVATE_IMAGE=mirror.gcr.io/renovate/renovate:44.262.2@sha256:2d5cd4c778b9a2c36623302ceec231a813d8eed77cea19da13b73dd4e8e92e54
SEMGREP_IMAGE=semgrep/semgrep:1.187.0@sha256:0c8dfa7aa1ca8c50233ec9110e8cd88d139dedd603d56507493f74c6f4b3e062
OPENGREP_VERSION=1.33.1
OPENGREP_SHA256=46e8133cc490f9f50518061590ce2f6be5a08afaeda034471c0ceda4b3899808
OPENGREP_URL=https://github.com/opengrep/opengrep/releases/download/v1.33.1/opengrep_manylinux_x86
