#
# Image of the workflow gate (tools/ci/workflow-check.sh), pinned by version and digest.
# Renovate reads it from the line (renovate.json, customManagers) and moves both together.
# mirror.gcr.io serves Docker Hub's digests; hosted runners share Docker Hub's anonymous pull limit.
# zizmor is installed from PyPI with hashes (tools/ci/zizmor-requirements.txt).
ACTIONLINT_IMAGE=mirror.gcr.io/rhysd/actionlint:1.7.12@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667
OPENGREP_VERSION=1.30.0
OPENGREP_SHA256=35779bdd72e92129c8df2a77f0c55e8c08356801ea92591ef32108d6b28d564c
OPENGREP_URL=https://github.com/opengrep/opengrep/releases/download/v1.30.0/opengrep_manylinux_x86
