#
# Images of the workflow gate (tools/ci/workflow-check.sh), each pinned by version and digest.
# Renovate reads both from the line (renovate.json, customManagers) and moves them together.
# mirror.gcr.io serves Docker Hub's digests; hosted runners share Docker Hub's anonymous pull limit.
ACTIONLINT_IMAGE=mirror.gcr.io/rhysd/actionlint:1.7.12@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667
ZIZMOR_IMAGE=ghcr.io/zizmorcore/zizmor:1.30.1@sha256:a2eb396d886c053073405c7a980f2139ba2248ec172243cfa3841e57196e8101
