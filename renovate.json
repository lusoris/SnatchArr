{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "before 6am on monday"
  ],
  "enabledManagers": [
    "gomod",
    "cargo",
    "npm",
    "github-actions",
    "dockerfile",
    "docker-compose",
    "helm-values",
    "helmv3",
    "devcontainer",
    "pip_requirements",
    "custom.regex"
  ],
  "customManagers": [
    {
      "description": "Upstream OpenAPI spec pins on a release: repository, release tag and commit of each entry, in this order (docs/upstream-contracts.md)",
      "customType": "regex",
      "managerFilePatterns": [
        "tools/upstreamspec/specs.yaml"
      ],
      "matchStrings": [
        "- name: (?<depName>\\S+)\\n +repository: (?<packageName>\\S+)\\n +tag: (?<currentValue>\\S+)\\n +commit: (?<currentDigest>[0-9a-f]{40})\\n"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "loose"
    },
    {
      "description": "Upstream OpenAPI spec pins on a branch, for a project that tags no release: repository, branch and commit of each entry, in this order. github-digest resolves the branch to its newest commit and dates it, so minimumReleaseAge applies (docs/upstream-contracts.md)",
      "customType": "regex",
      "managerFilePatterns": [
        "tools/upstreamspec/specs.yaml"
      ],
      "matchStrings": [
        "- name: (?<depName>\\S+)\\n +repository: (?<packageName>\\S+)\\n +branch: (?<currentValue>\\S+)\\n +commit: (?<currentDigest>[0-9a-f]{40})\\n"
      ],
      "datasourceTemplate": "github-digest"
    },
    {
      "description": "Images of the workflow gate, each pinned by version and digest on one line (tools/ci/workflow-check.sh)",
      "customType": "regex",
      "managerFilePatterns": [
        "tools/ci/tool-versions.env"
      ],
      "matchStrings": [
        "ACTIONLINT_IMAGE=mirror\\.gcr\\.io/(?<depName>rhysd/actionlint):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})\\n",
        "ZIZMOR_IMAGE=(?<depName>ghcr\\.io/zizmorcore/zizmor):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})\\n"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "description": "Go tools installed in workflows, pinned to semver (tools/ci/workflow-check.sh)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "go install (?<depName>\\S+)/cmd/[^@\\s]+@(?<currentValue>v[0-9]+(?:\\.[0-9]+)*)"
      ],
      "datasourceTemplate": "go"
    },
    {
      "description": "Go tools of the devcontainer, pinned to semver; the module path ends before /cmd/ (.devcontainer/snatcharr/post-create.sh)",
      "customType": "regex",
      "managerFilePatterns": [
        ".devcontainer/snatcharr/post-create.sh"
      ],
      "matchStrings": [
        "go install (?<depName>[^@\\s]+?)(?:/cmd/[^@\\s]+)?@(?<currentValue>v[0-9]+(?:\\.[0-9]+)*)\\n"
      ],
      "datasourceTemplate": "go"
    },
    {
      "description": "Cargo tools of the devcontainer (.devcontainer/snatcharr/post-create.sh)",
      "customType": "regex",
      "managerFilePatterns": [
        ".devcontainer/snatcharr/post-create.sh"
      ],
      "matchStrings": [
        "cargo install --locked (?<depName>[a-z0-9_-]+)@(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\n"
      ],
      "datasourceTemplate": "crate"
    },
    {
      "description": "kubectl and helm of the devcontainer feature, which Renovate's devcontainer manager does not version",
      "customType": "regex",
      "managerFilePatterns": [
        ".devcontainer/snatcharr/devcontainer.json"
      ],
      "matchStrings": [
        "kubectl-helm-minikube:1\": \\{ \"version\": \"(?<currentValue>[0-9.]+)\""
      ],
      "depNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "description": "helm of the devcontainer feature",
      "customType": "regex",
      "managerFilePatterns": [
        ".devcontainer/snatcharr/devcontainer.json"
      ],
      "matchStrings": [
        "\"helm\": \"(?<currentValue>[0-9.]+)\""
      ],
      "depNameTemplate": "helm/helm",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "description": "The Postgres of the integration tests and the end-to-end smoke, pinned by version and digest outside a workflow or Dockerfile (storetest, tools/e2e/postgres.sh, Makefile); same image as the CI service containers",
      "customType": "regex",
      "managerFilePatterns": [
        "api/internal/store/storetest/storetest.go",
        "tools/e2e/postgres.sh",
        "Makefile"
      ],
      "matchStrings": [
        "(?<depName>(?:mirror\\.gcr\\.io/library/)?postgres):(?<currentValue>[0-9]+-alpine)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "description": "The CloudNativePG operand images of the chart upgrade test, pinned by version and digest (tools/e2e/cnpg_pg_upgrade.sh, #252)",
      "customType": "regex",
      "managerFilePatterns": [
        "tools/e2e/cnpg_pg_upgrade.sh"
      ],
      "matchStrings": [
        "(?:OLD|NEW)_IMAGE=(?<depName>ghcr\\.io/cloudnative-pg/postgresql):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})\\n"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "description": "The S3 store of the chart backup and restore test, pinned by version and digest (tools/e2e/cnpg_backup_restore.sh, C14-04)",
      "customType": "regex",
      "managerFilePatterns": [
        "tools/e2e/cnpg_backup_restore.sh"
      ],
      "matchStrings": [
        "RUSTFS_IMAGE=(?<depName>mirror\\.gcr\\.io/rustfs/rustfs):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})\\n"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "description": "cert-manager and the Barman Cloud plugin the deploy job installs for the backup and restore test, pinned by release (.github/workflows/ci.yml)",
      "customType": "regex",
      "managerFilePatterns": [
        ".github/workflows/ci.yml"
      ],
      "matchStrings": [
        "https://github\\.com/(?<depName>cert-manager/cert-manager|cloudnative-pg/plugin-barman-cloud)/releases/download/(?<currentValue>v[0-9.]+)/"
      ],
      "datasourceTemplate": "github-releases"
    }
  ],
  "postUpdateOptions": [
    "gomodTidy",
    "pnpmDedupe"
  ],
  "packageRules": [
    {
      "description": "One weekly pull request per manager for non-major updates, so the strict up-to-date rule reruns CI once per group (HISS-18)",
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "gomod non-major"
    },
    {
      "description": "One weekly pull request per manager for non-major updates, so the strict up-to-date rule reruns CI once per group (HISS-18)",
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "cargo non-major"
    },
    {
      "description": "One weekly pull request per manager for non-major updates, so the strict up-to-date rule reruns CI once per group (HISS-18)",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "npm non-major"
    },
    {
      "description": "One weekly pull request per manager for non-major updates, so the strict up-to-date rule reruns CI once per group (HISS-18)",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "github-actions non-major"
    },
    {
      "description": "One weekly pull request per manager for non-major updates, so the strict up-to-date rule reruns CI once per group (HISS-18)",
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "dockerfile non-major"
    },
    {
      "description": "One weekly pull request per manager for non-major updates, so the strict up-to-date rule reruns CI once per group (HISS-18)",
      "matchManagers": [
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "docker-compose non-major"
    },
    {
      "description": "One weekly pull request per manager for non-major updates, so the strict up-to-date rule reruns CI once per group (HISS-18)",
      "matchManagers": [
        "helm-values"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "helm-values non-major"
    },
    {
      "description": "One weekly pull request per manager for non-major updates, so the strict up-to-date rule reruns CI once per group (HISS-18)",
      "matchManagers": [
        "helmv3"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "helmv3 non-major"
    },
    {
      "description": "One weekly pull request per manager for non-major updates, so the strict up-to-date rule reruns CI once per group (HISS-18)",
      "matchManagers": [
        "devcontainer"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "devcontainer non-major"
    },
    {
      "matchPackageNames": [
        "/^github.com/golusoris//"
      ],
      "groupName": "golusoris"
    },
    {
      "matchPackageNames": [
        "/^@sveltesentio//"
      ],
      "groupName": "sveltesentio"
    },
    {
      "matchPackageNames": [
        "tonic",
        "tonic-build",
        "prost",
        "prost-types"
      ],
      "groupName": "tonic"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Automerge non-major updates once the required checks pass; majors stay manual",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true
    },
    {
      "description": "Pins a custom manager reads are merged by hand. Upstream spec pins: Renovate cannot renew the sha256 of a spec file (docs/upstream-contracts.md). Workflow gate tools: a new version changes what a required check refuses, so a person reads its release notes",
      "matchManagers": [
        "custom.regex"
      ],
      "groupName": "upstream specs",
      "automerge": false
    },
    {
      "description": "Sonarr/Sonarr also holds the release tags of Radarr from v4.1 to v6, which point at Radarr commits (#231 proposed v6.4.4, #249 v4.7.5). Its published releases are Sonarr's own, so Sonarr resolves through github-releases; the digest stays the commit of the tag, and prereleases count as unstable (docs/upstream-contracts.md)",
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "Sonarr/Sonarr"
      ],
      "overrideDatasource": "github-releases"
    },
    {
      "description": "The two images of the workflow gate move in a pull request of their own",
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "tools/ci/tool-versions.env"
      ],
      "groupName": "workflow gate tools"
    },
    {
      "description": "praetor-managed files: praetorctl adopt ships their updates and praetorctl audit locks them byte for byte",
      "matchFileNames": [
        ".github/workflows/praetor-api.yml",
        "tools/apicompat/gate/main.go",
        "tools/apicompat/gate/placeholder.go",
        ".devcontainer/devcontainer.json",
        ".devcontainer/Dockerfile.praetor"
      ],
      "enabled": false
    },
    {
      "description": "TypeScript 7 drops the JavaScript compiler API that @sveltejs/kit reads tsconfig through (svelte-kit sync fails with \"Cannot read properties of undefined (reading 'readFile')\"), and @sveltejs/kit 3.1.0 declares the peer range typescript ^6.0.0. Revisit when a released @sveltejs/kit peer range admits typescript 7 (#149)",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7"
    },
    {
      "description": "The upgrade test moves a database from the previous Postgres major to the current one (storetest.PreviousMajorImage, #252): that pin takes digest and minor updates but stays on major 17. Move it with the current major when Postgres 19 is adopted",
      "matchFileNames": [
        "api/internal/store/storetest/storetest.go"
      ],
      "matchDepNames": [
        "postgres"
      ],
      "matchCurrentValue": "/^17-/",
      "allowedVersions": "/^17-/"
    },
    {
      "description": "The chart upgrade test moves a CloudNativePG cluster from the previous Postgres major to the current one (tools/e2e/cnpg_pg_upgrade.sh, #252): each operand pin takes digest and minor updates on its own major. Move both, with old_major and new_major, when Postgres 19 is adopted",
      "matchFileNames": [
        "tools/e2e/cnpg_pg_upgrade.sh"
      ],
      "matchDepNames": [
        "ghcr.io/cloudnative-pg/postgresql"
      ],
      "matchCurrentValue": "/^17\\./",
      "allowedVersions": "/^17\\./"
    },
    {
      "description": "See the rule above: the current-major operand pin of the chart upgrade test stays on 18",
      "matchFileNames": [
        "tools/e2e/cnpg_pg_upgrade.sh"
      ],
      "matchDepNames": [
        "ghcr.io/cloudnative-pg/postgresql"
      ],
      "matchCurrentValue": "/^18\\./",
      "allowedVersions": "/^18\\./"
    }
  ],
  "minimumReleaseAge": "3 days",
  "platformCommit": "enabled",
  "vulnerabilityAlerts": {
    "groupName": null,
    "schedule": [
      "at any time"
    ],
    "minimumReleaseAge": null
  }
}
