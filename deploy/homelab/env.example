#
# Copy to .env next to compose.yaml and fill in every value. Generate each secret with
#   openssl rand -hex 32
# Hex keeps the database password safe inside the connection URL. Keep .env out of version
# control and back it up with the database: without SNATCHARR_CRYPTO_KEY the stored *arr API
# keys cannot be decrypted.

# Required secrets.
SNATCHARR_DB_PASSWORD=
SNATCHARR_CRYPTO_KEY=
SNATCHARR_CSRF_SECRET=
SNATCHARR_APIKEY_SECRET=
SNATCHARR_WORKER_TOKEN=
# Asked for on the first-run setup screen, so nobody else on the network can claim the admin.
SNATCHARR_SETUP_SECRET=

# Where the UI is reached. Behind an HTTPS reverse proxy keep SESSION_SECURE=true; on plain
# HTTP the browser drops secure cookies, so set it to false there.
SNATCHARR_PUBLIC_URL=http://localhost:8080
SNATCHARR_SESSION_SECURE=true
# Host address and port the UI is published on. 127.0.0.1 = this host only; 0.0.0.0 = the LAN.
SNATCHARR_BIND=127.0.0.1
SNATCHARR_PORT=8080
