      "title": "Run Lease Wait Time (p50 / p95)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.50, sum by (le, kind) (rate(snatcharr_run_lease_wait_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 - {{kind}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(snatcharr_run_lease_wait_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 - {{kind}}",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
