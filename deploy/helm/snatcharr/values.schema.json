{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "snatcharr values",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "api": { "$ref": "#/$defs/image" },
        "worker": { "$ref": "#/$defs/image" }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "publicUrl": { "type": "string" },
        "sessionTtl": { "type": "string" },
        "trustedProxies": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "configarr": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "existingConfigMap": { "type": "string" },
        "configKey": { "type": "string" },
        "downloadClientsKey": { "type": "string" },
        "existingSecret": { "type": "string" },
        "secretsKey": { "type": "string" },
        "watch": { "type": "boolean" }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "cryptoKey": { "type": "string", "pattern": "^([0-9a-fA-F]{32}|[0-9a-fA-F]{48}|[0-9a-fA-F]{64})?$" },
        "csrfSecret": { "type": "string", "pattern": "^([0-9a-fA-F]{64}|[A-Za-z0-9+/]{43}=|[A-Za-z0-9_-]{43}=)?$" },
        "apiKeySecret": { "type": "string" },
        "workerToken": { "type": "string" },
        "setupSecret": { "type": "string" }
      }
    },
    "postgres": {
      "type": "object",
      "properties": {
        "cnpg": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "instances": { "type": "integer", "minimum": 1 },
            "storage": {
              "type": "object",
              "properties": { "size": { "type": "string" }, "storageClass": { "type": "string" } }
            },
            "bootstrap": { "type": "object", "maxProperties": 1 },
            "extraSpec": { "type": "object", "not": { "required": ["bootstrap"] } }
          }
        },
        "external": {
          "type": "object",
          "properties": {
            "dsnSecretRef": {
              "type": "object",
              "properties": { "name": { "type": "string" }, "key": { "type": "string" } }
            }
          }
        }
      }
    },
    "api": { "$ref": "#/$defs/component" },
    "worker": {
      "allOf": [
        { "$ref": "#/$defs/component" },
        {
          "properties": {
            "concurrency": { "type": "integer", "minimum": 1, "maximum": 32 },
            "heartbeatSecs": { "type": "integer", "minimum": 5 },
            "leaseWaitSecs": { "type": "integer", "minimum": 1, "maximum": 60 },
            "arrTimeoutSecs": { "type": "integer", "minimum": 5 },
            "httpPort": { "type": "integer", "minimum": 1024, "maximum": 65535 },
            "staleSecs": { "type": "integer", "minimum": 60, "maximum": 3600 },
            "autoscaling": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "minReplicas": { "type": "integer", "minimum": 1 },
                "maxReplicas": { "type": "integer", "minimum": 1 },
                "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 },
                "keda": {
                  "type": "object",
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "serverAddress": { "type": "string" },
                    "query": { "type": "string" },
                    "threshold": { "type": ["string", "number"] }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      ]
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "arrCidrs": { "type": "array", "items": { "type": "string" } },
        "arrPeers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "podSelector": { "type": "object" },
              "namespaceSelector": { "type": "object" },
              "ports": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "port": { "type": ["integer", "string"] },
                    "endPort": { "type": "integer" },
                    "protocol": { "type": "string", "enum": ["TCP", "UDP", "SCTP"] }
                  },
                  "required": ["port"],
                  "additionalProperties": false
                }
              }
            },
            "anyOf": [{ "required": ["podSelector"] }, { "required": ["namespaceSelector"] }],
            "additionalProperties": false
          }
        }
      }
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "component": {
      "type": "object",
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 0 },
        "resources": { "type": "object" }
      }
    }
  }
}
