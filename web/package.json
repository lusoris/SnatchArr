{
	"name": "@snatcharr/web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm gen:i18n && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"gen:api": "openapi-typescript ../api/openapi/openapi.yaml -o src/lib/api/schema.d.ts",
		"gen:theme": "tsx scripts/gen-theme.ts",
		"typecheck": "pnpm gen:i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && node --import=tsx ./node_modules/eslint/bin/eslint.js .",
		"format": "prettier --write .",
		"test": "pnpm gen:i18n && vitest run --coverage",
		"test:watch": "vitest",
		"test:e2e": "playwright install --with-deps chromium && playwright test",
		"gen:i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@bufbuild/protobuf": "^2.15.0",
		"@connectrpc/connect": "^2.2.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@sveltesentio/testing": "0.1.0",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^24",
		"@vitest/coverage-v8": "^4.1.11",
		"axe-core": "^4.13.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"jsdom": "^30.1.0",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-axe": "^0.1.0"
	},
	"dependencies": {
		"@inlang/paraglide-js": "^2.25.4",
		"@sveltesentio/api": "0.3.0",
		"@sveltesentio/auth": "0.6.0",
		"@sveltesentio/charts": "0.5.0",
		"@sveltesentio/core": "0.3.0",
		"@sveltesentio/i18n": "0.3.0",
		"@sveltesentio/query": "0.3.0",
		"@sveltesentio/realtime": "0.4.0",
		"@sveltesentio/ui": "0.5.0",
		"@tanstack/svelte-query": "^6.2.1",
		"openapi-fetch": "^0.17.0",
		"svelte-sonner": "^1.2.1",
		"zod": "^4.6.5"
	}
}
