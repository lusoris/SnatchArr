# Image of the visual baseline (tools/e2e/web_visual.sh), pinned by version and digest.
# The version must equal @playwright/test in web/pnpm-lock.yaml; Renovate moves both in one
# pull request (renovate.json, group "playwright"), and the script refuses a mismatch.
PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.64.1-noble@sha256:47b510dd9230bf0b9bfc9b20102241e577ea7a99334ab4c3ca19f19770e9b8ea
